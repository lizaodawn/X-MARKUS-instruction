        },
        {
          "name": "inference",
          "type": "enum",
          "values": [
            "abandonment",
            "brakedown"
          ],
          "description": "Breakdown describes every object part that experienced repairs or was built on top of. This is seen in stratigraphic diagrams. This is for multilayered (usually big) sites (Yangzhou, Chengdu, Chongqing...) \nAbandonment describes an object part that was not built on top of but was abandoned or no longer serves its intended use (e.g. walls that now serve as tourist attractions have lost their initial purpose at some point, therefore that is abandonment). This is seen on all types of images that contain obj_part on for both bigger and smaller sites \nConnected properties: Date End represents the point in time connected to the eventlet. Location represents the physical location of the eventlet and is also mandatory. "
        },
        {
          "name": "same object part",
          "type": "relation",
          "targetType": "obj_part",
          "labelProperty": "name",
          "description": "Same object part connects different annotations of the same part object in different images (e.g. on a stratigraphical diagram and a site plan). Type: same as "
        },
        {
          "name": "part of main object",
          "type": "relation",
          "targetType": "object",
